# Server
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/photomall
STORAGE_LIMIT_GB=10

# SMTP (Gmail example — use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# URLs
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:5000
